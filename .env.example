# Copy to .env and fill in. Never commit .env.

# Amazon Bedrock, OpenAI-compatible endpoint
Bedrock_API_key=
OPENAI_BASE_URL=https://bedrock-mantle.eu-north-1.api.aws/v1

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# optional: defaults are development and the git commit; false turns tracing off
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=
# LANGFUSE_TRACING_ENABLED=true

# vLLM: only needed outside Docker, and only if it is not on the default http://localhost:8001/v1.
# docker compose ignores it (the API container reaches the vllm service; API_VLLM_URL overrides that).
# VLLM_BASE_URL=http://localhost:8001/v1
