# Copy to .env and fill in. Never commit .env.

# Amazon Bedrock, OpenAI-compatible endpoint (optional: the main model is Qwen2.5 on vLLM).
# No suitable GPU? Set LLM_BACKEND=bedrock and start the API alone: docker compose up --build api
# (vLLM is then not started and nothing is loaded on the GPU). Region: change OPENAI_BASE_URL.
# LLM_BACKEND=bedrock
Bedrock_API_key=
OPENAI_BASE_URL=https://bedrock-mantle.eu-north-1.api.aws/v1

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# optional: defaults are development and the git commit; false turns tracing off
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=
# LANGFUSE_TRACING_ENABLED=true

# vLLM: only needed outside Docker, and only if it is not on the default http://localhost:8001/v1.
# docker compose ignores it (the API container reaches the vllm service; API_VLLM_URL overrides that).
# VLLM_BASE_URL=http://localhost:8001/v1

# Smaller GPU (about 2 GB of VRAM free): the small model instead of Qwen2.5-7B. docker compose, scripts/serve_vllm.sh
# and the app all read these two lines; remove them to go back to the 7B.
# VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ
# VLLM_MEMORY_ARGS=--kv-cache-memory 201326592 --max-model-len 6144 --enforce-eager --max-num-seqs 4 --max-num-batched-tokens 2048
