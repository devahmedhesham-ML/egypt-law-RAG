# Copy to .env and fill in. Never commit .env.

# Amazon Bedrock, OpenAI-compatible endpoint
Bedrock_API_key=
OPENAI_BASE_URL=https://bedrock-mantle.eu-north-1.api.aws/v1

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# optional: defaults are development and the git commit; false turns tracing off
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=
# LANGFUSE_TRACING_ENABLED=true

# vLLM server started from the serve venv
VLLM_BASE_URL=http://localhost:8000/v1
